NOVA_ENV=development
NOVA_WORKSPACE=./data/workspace
NOVA_DATABASE_PATH=./data/nova.sqlite3
NOVA_AUDIT_PATH=./data/audit.jsonl
NOVA_LITERT_BASE_URL=http://127.0.0.1:9379/v1
NOVA_LITERT_MODEL=local-model
# Optional local speech and specialist runtimes; never used as silent chat fallbacks.
# NOVA_WHISPER_CLI_PATH=/usr/local/bin/whisper-cli
NOVA_WHISPER_MODEL_PATH=./data/models/whisper/ggml-base.bin
NOVA_WHISPER_TIMEOUT_SECONDS=180
NOVA_WHISPER_MAX_UPLOAD_BYTES=25000000
# NOVA_PIPER_CLI_PATH=/usr/local/bin/piper
NOVA_PIPER_MODEL_PATH=./data/models/piper/voice.onnx
# NOVA_LLAMA_CPP_SERVER_PATH=/usr/local/bin/llama-server
NOVA_ONNXRUNTIME_ENABLED=true
NOVA_HUGGINGFACE_CACHE_DIR=./data/models/huggingface
NOVA_HUGGINGFACE_MAX_DOWNLOAD_BYTES=2000000000
# Optional local image OCR runtime. Install Tesseract and Pillow separately; no download is automatic.
# NOVA_TESSERACT_CLI_PATH=/usr/bin/tesseract
NOVA_OCR_TIMEOUT_SECONDS=60
NOVA_OCR_MAX_UPLOAD_BYTES=15000000
# Optional: use a Hugging Face read token for gated/private repositories. Never commit real tokens.
# NOVA_HUGGINGFACE_TOKEN=hf_your_token_here
NOVA_REQUIRE_APPROVAL_FOR_WRITES=true
# Optional background worker. Defaults to disabled; due tasks only move to Planned for human review.
NOVA_SCHEDULER_ENABLED=false
NOVA_SCHEDULER_INTERVAL_SECONDS=15
